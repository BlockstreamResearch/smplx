#!/usr/bin/env bash
set -eo pipefail

# NOTE: if you make modifications to this script, please increment the version number.
# WARNING: the SemVer pattern: major.minor.patch must be followed as we use it to determine if the script is up to date.
SIMPLEXUP_INSTALLER_VERSION="0.0.7"

BASE_DIR=${XDG_CONFIG_HOME:-$HOME}
SIMPLEX_DIR=${SIMPLEX_DIR:-"$BASE_DIR/.simplex"}
SIMPLEX_VERSIONS_DIR="$SIMPLEX_DIR/versions"
SIMPLEX_BIN_DIR="$SIMPLEX_DIR/bin"
SIMPLEX_BIN_URL="https://raw.githubusercontent.com/BlockstreamResearch/smplx/master/simplexup/simplexup"
SIMPLEX_BIN_PATH="$SIMPLEX_BIN_DIR/simplexup"
DEFAULT_SIMPLEX_REPO="BlockstreamResearch/smplx"
SIMPLEXUP_IGNORE_VERIFICATION=false

SMPLX_BIN_NAME="simplex"
# Every binary a release may ship
ALL_BINS=("${SMPLX_BIN_NAME}" elementsd electrs smplx-nextest)
# Written last into a version dir, so an interrupted or rejected install is never used
COMPLETE_MARKER=".complete"

# Set by `resolve_install`
VERSION_DIR=""
# The binaries the installed version is made of
RELEASE_BINS=()
# The ones taken from the release archive
ARCHIVE_BINS=()

# Set by `install_version`, removed on exit
WORK_DIR=""

# Set by `fetch_attestation`
ATTESTATION_FOUND=false
ATTESTATION_BUNDLE=""
# The statement, listing each binary's name and SHA-256
ATTESTATION_STATEMENT=""
# If the GitHub CLI also checks who signed the attestation
GH_VERIFY=false

main() {
  need_cmd git
  need_cmd curl
  need_cmd jq

  while [[ -n $1 ]]; do
    case $1 in
      --)               shift; break;;

      -v|--version)     shift; version;;
      -C|--commit)      shift; SIMPLEX_COMMIT=$1;;
      -U|--update)      shift; update;;
      -r|--repo)        shift; SIMPLEX_REPO=$1;;
      -i|--install)     shift; SIMPLEX_VERSION=$1;;
      -l|--list)        shift; list;;
      -u|--use)         shift; use "$1";;
      -f|--force)       SIMPLEXUP_IGNORE_VERIFICATION=true;;
      --arch)           shift; SIMPLEX_ARCH=$1;;
      --platform)       shift; SIMPLEX_PLATFORM=$1;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        warn "unknown option: $1"
        usage
        exit 1
    esac; shift
  done

  # Print the banner after successfully parsing args
  banner

  check_installer_up_to_date
  install_version
}

# Installs the requested release, or the latest one. The binaries are verified before any of them
# enters the version dir, and the version is activated once they are all in.
install_version() {
  resolve_install

  WORK_DIR="$(mktemp -d 2>/dev/null)" || err "failed to create temp dir"
  trap 'rm -rf "${WORK_DIR:?}"' EXIT

  if fetch_attestation && [[ -z "$SIMPLEX_COMMIT" ]] && verify_bins "$VERSION_DIR"; then
    say "version $SIMPLEX_VERSION already installed and verified, activating..."
    touch "$VERSION_DIR/$COMPLETE_MARKER"
    use "$(basename "$VERSION_DIR")"
  fi

  local release_dir="$WORK_DIR/release"
  download_release "$release_dir"

  if $ATTESTATION_FOUND; then
    say "verifying downloaded binaries against the attestation"
    verify_bins "$release_dir" verbose || err "one or more binaries failed verification"
  fi

  if [[ -n "$SIMPLEX_COMMIT" ]]; then
    build_from_commit "$release_dir"
  fi

  store_version "$release_dir"
  use "$(basename "$VERSION_DIR")"
}

# Activates installed version $1. Every binary is replaced and the ones $1 doesn't ship are removed,
# so no two versions mix.
use() {
  [ -z "$1" ] && err "no version provided"

  local name
  name=$(add_v_prefix "$1")
  local dir="$SIMPLEX_VERSIONS_DIR/$name"

  [ -f "$dir/$COMPLETE_MARKER" ] || err "version $name not installed"

  check_bins_in_use "${ALL_BINS[@]}"
  ensure mkdir -p "$SIMPLEX_BIN_DIR"

  for bin in "${ALL_BINS[@]}"; do
    local bin_path="$SIMPLEX_BIN_DIR/$bin"

    if [ ! -f "$dir/$bin" ]; then
      rm -f "${bin_path:?}"
      continue
    fi

    ensure cp "$dir/$bin" "$bin_path"

    if [ "$bin" = "$SMPLX_BIN_NAME" ]; then
      say "- $(ensure "$bin_path" -V)"
    fi

    warn_if_shadowed "$bin" "$bin_path"
  done

  say "done!"
  exit 0
}

list() {
  if [ -d "$SIMPLEX_VERSIONS_DIR" ]; then
    for dir in "$SIMPLEX_VERSIONS_DIR"/*; do
      say "${dir##*/}"

      if [ -f "$dir/$COMPLETE_MARKER" ]; then
        say "- $(ensure "$dir/$SMPLX_BIN_NAME" -V)"
      else
        say "- incomplete install"
      fi

      printf "\n"
    done
  else
    say "- $(ensure "$SIMPLEX_BIN_DIR/$SMPLX_BIN_NAME" -V)"
  fi

  exit 0
}

update() {
  say "updating simplexup..."

  local current_version="$SIMPLEXUP_INSTALLER_VERSION"
  local tmp_file
  tmp_file="$(mktemp)"

  ensure download "$SIMPLEX_BIN_URL" "$tmp_file"

  local new_version
  new_version=$(extract_installer_version < "$tmp_file" || true)

  # An empty or invalid version is never installed
  if [ -z "$new_version" ]; then
    warn "could not determine the new simplexup version"
    rm -f "$tmp_file"
    exit 0
  fi

  # Neither a downgrade nor a reinstall of the same version
  if ! version_gt "$new_version" "$current_version"; then
    say "simplexup is already up to date (installed: $current_version, remote: $new_version)"
    rm -f "$tmp_file"
    exit 0
  fi

  ensure mv "$tmp_file" "$SIMPLEX_BIN_PATH"
  ensure chmod +x "$SIMPLEX_BIN_PATH"

  say "updated simplexup: $current_version → $new_version"
  exit 0
}

version() {
  say "$SIMPLEXUP_INSTALLER_VERSION"
  exit 0
}

usage() {
  cat 1>&2 <<EOF
The installer for Simplex.

Install, update, and manage Simplex with ease.

By default, the latest stable version is installed from built binaries.

USAGE:
    simplexup <OPTIONS>

OPTIONS:
    -h, --help      Print help information
    -v, --version   Print the version of simplexup
    -C, --commit    Install specific Simplex revision from repository
    -U, --update    Update simplexup to the latest version
    -i, --install   Install a specific version from built binaries
    -l, --list      List versions installed from built binaries
    -u, --use       Use a specific installed version from built binaries
    -r, --repo      Build and install from a remote GitHub repo (uses default branch if no other options are set)
    -f, --force     Skip SHA verification for downloaded binaries (INSECURE - use with caution)
    --arch          Install a specific architecture (supports amd64 and arm64)
    --platform      Install a specific platform (supports linux and darwin)
EOF
}

# Settles the version to install, where its binaries come from, and where they go.
# A commit build gets its own version dir, so a release's binaries are never replaced.
resolve_install() {
  SIMPLEX_REPO=${SIMPLEX_REPO:-$DEFAULT_SIMPLEX_REPO}

  local latest_tag
  latest_tag=$(latest_tag)
  SIMPLEX_VERSION=$(add_v_prefix "${SIMPLEX_VERSION:-$latest_tag}")

  set_release_bins "${SIMPLEX_VERSION#v}"
  check_bins_in_use "${RELEASE_BINS[@]}"

  if [[ "$SIMPLEX_VERSION" != "$latest_tag" ]]; then
    validate_tag_version
  fi

  say "installing simplex (version ${SIMPLEX_VERSION})"

  detect_platform_arch

  GITHUB_REPO_URL="https://github.com/${SIMPLEX_REPO}"

  local release_url="${GITHUB_REPO_URL}/releases/download/${SIMPLEX_VERSION}/simplex-${SIMPLEX_VERSION}-${PLATFORM}-${ARCHITECTURE}"
  ATTESTATION_URL="${release_url}.attestation.txt"
  BIN_ARCHIVE_URL="${release_url}.tar.gz"

  if [[ -n "$SIMPLEX_COMMIT" ]]; then
    VERSION_DIR="${SIMPLEX_VERSIONS_DIR}/${SIMPLEX_REPO%%/*}-${SIMPLEX_COMMIT}"
    ARCHIVE_BINS=("${RELEASE_BINS[@]:1}")
  else
    VERSION_DIR="${SIMPLEX_VERSIONS_DIR}/${SIMPLEX_VERSION}"
    ARCHIVE_BINS=("${RELEASE_BINS[@]}")
  fi
}

# Loads the release's attestation. Returns non-zero if nothing is loaded or when `--force` skips verification,
# or if the release has no attestation.
fetch_attestation() {
  if [ "$SIMPLEXUP_IGNORE_VERIFICATION" = true ]; then
    say "skipping SHA verification due to --force flag"
    return 1
  fi

  check_cmd sha256sum || check_cmd shasum || err "need 'sha256sum' or 'shasum' (command not found)"

  say "checking the attestation for $SIMPLEX_VERSION version"

  # The first line of the attestation file links to the attestation bundle
  local link_file="$WORK_DIR/attestation.txt"
  download "$ATTESTATION_URL" "$link_file" || : > "$link_file"

  local bundle_link
  bundle_link="$(head -n1 "$link_file" | tr -d '\r')"

  if [ -z "$bundle_link" ] || grep -q 'Not Found' "$link_file"; then
    say "no attestation found for this release, skipping SHA verification"
    return 1
  fi

  say "found attestation for $SIMPLEX_VERSION version, downloading attestation bundle, checking..."

  ATTESTATION_BUNDLE="$WORK_DIR/attestation.json"
  ensure download "${bundle_link}/download" "$ATTESTATION_BUNDLE"

  ATTESTATION_STATEMENT=$(jq -r '.dsseEnvelope.payload | @base64d' "$ATTESTATION_BUNDLE") \
    || err "attestation bundle is malformed"
  ATTESTATION_FOUND=true

  # Checking the signer needs GitHub's API. Done only if gh exists and is logged in
  if check_cmd gh && gh auth status &>/dev/null; then
    GH_VERIFY=true
  else
    say "gh not found or not logged in, checking the attested hashes only"
  fi
}

# Downloads the release archive and extracts its binaries into $1
download_release() {
  local out_dir=$1
  local archive="$out_dir/simplex.tar.gz"

  say "downloading $(form_str_list "${ARCHIVE_BINS[@]}") for $SIMPLEX_VERSION version"

  ensure mkdir -p "$out_dir"
  ensure download "$BIN_ARCHIVE_URL" "$archive"
  # Make sure it's a valid tar archive.
  ensure tar tf "$archive" 1> /dev/null
  ensure tar -C "$out_dir" -xf "$archive"
}

# Checks the archive binaries in dir $1 against the attestation. With $2 set, reports on each of them.
verify_bins() {
  local dir=$1
  local verbose=$2
  local verified=true

  for bin in "${ARCHIVE_BINS[@]}"; do
    local path="$dir/$bin"
    local expected actual
    expected=$(attested_hash "$bin")

    if [ -z "$expected" ]; then
      [ -n "$verbose" ] && say "no expected hash for $bin"
      verified=false
      continue
    fi

    if [ ! -x "$path" ]; then
      [ -n "$verbose" ] && say "binary $bin not found at $path"
      verified=false
      continue
    fi

    actual=$(compute_sha256 "$path")

    if [ "$actual" != "$expected" ]; then
      if [ -n "$verbose" ]; then
        say "$bin hash verification failed:"
        say "  expected: $expected"
        say "  actual:   $actual"
      fi
      verified=false
    elif $GH_VERIFY && ! gh_verify "$path"; then
      [ -n "$verbose" ] && say "$bin attestation is not signed by the $SIMPLEX_REPO release workflow"
      verified=false
    elif [ -n "$verbose" ]; then
      say "$bin verified ✓"
    fi
  done

  $verified
}

# Checks with the GitHub CLI that the attestation bundle attests binary $1 and that the release workflow signed the bundle
gh_verify() {
  gh attestation verify "$1" \
    --bundle "$ATTESTATION_BUNDLE" \
    --repo "$SIMPLEX_REPO" \
    --signer-workflow "$SIMPLEX_REPO/.github/workflows/release.yml" \
    &>/dev/null
}

# Builds simplex at SIMPLEX_COMMIT into dir $1, in place of the release's
build_from_commit() {
  need_cmd cargo

  local out_dir=$1
  local src_dir="$WORK_DIR/source"

  say "building simplex from commit ${SIMPLEX_COMMIT} of ${GITHUB_REPO_URL}"

  ensure git clone --revision="${SIMPLEX_COMMIT}" --depth=1 "${GITHUB_REPO_URL}" "${src_dir}"
  ensure cargo build --release --manifest-path "${src_dir}/Cargo.toml"
  ensure mv "${src_dir}/target/release/${SMPLX_BIN_NAME}" "${out_dir}/${SMPLX_BIN_NAME}"
}

# Moves the binaries from dir $1 into the version dir, which is marked complete once they are all in
store_version() {
  local from_dir=$1

  ensure mkdir -p "$VERSION_DIR"
  rm -f "${VERSION_DIR:?}/${COMPLETE_MARKER:?}"

  for bin in "${RELEASE_BINS[@]}"; do
    ensure mv "$from_dir/$bin" "$VERSION_DIR/$bin"
  done

  touch "$VERSION_DIR/$COMPLETE_MARKER"
}

check_installer_up_to_date() {
  say "checking if simplexup is up to date..."

  local remote_version
  remote_version=$(curl -fsSL "$SIMPLEX_BIN_URL" | extract_installer_version || true)

  if [ -z "$remote_version" ]; then
    warn "could not determine the remote simplexup version, skipping the check"
    return 0
  fi

  if version_gt "$remote_version" "$SIMPLEXUP_INSTALLER_VERSION"; then
    printf '
Your installation of simplexup is out of date.

Installed: %s → Latest: %s

To update, run:

  simplexup --update

Updating is highly recommended as it gives you access to the latest features and bug fixes.

' "$SIMPLEXUP_INSTALLER_VERSION" "$remote_version" >&2
  else
    say "simplexup is up to date"
  fi
}

validate_tag_version() {
  say "checking if version ${SIMPLEX_VERSION} exists..."

  if ! curl -IfsSL "https://github.com/${SIMPLEX_REPO}/releases/tag/${SIMPLEX_VERSION}" >/dev/null; then
    err "version ${SIMPLEX_VERSION} not found in ${SIMPLEX_REPO} releases"
  fi
}

# Fails while one of the binaries $@ is running
check_bins_in_use() {
  if ! check_cmd pgrep; then
    warn "make sure no simplex process runs during the install"
    return 0
  fi

  for bin in "$@"; do
    if pgrep -x "$bin" >/dev/null; then
      err "'$bin' is running, stop the process and try again"
    fi
  done
}

# Warns when another binary named $1 takes precedence over the installed $2 in PATH
warn_if_shadowed() {
  local bin=$1
  local bin_path=$2
  local which_path
  which_path="$(command -v "$bin" || true)"

  if [ -z "$which_path" ] || [ "$which_path" = "$bin_path" ]; then
    return 0
  fi

  warn ""
  cat 1>&2 <<EOF
There are multiple binaries with the name '$bin' present in your 'PATH'.

This may be the result of installing '$bin' using another method, like Cargo or other package managers.

You may need to run 'rm $which_path' or move '$SIMPLEX_BIN_DIR' in your 'PATH'
to allow the newly installed version to take precedence!

EOF
}

detect_platform_arch() {
  PLATFORM=$(tolower "${SIMPLEX_PLATFORM:-$(uname -s)}")

  case $PLATFORM in
    linux) ;;
    darwin|mac*)
      PLATFORM="darwin"
      ;;
    *)
      err "unsupported platform: $PLATFORM"
      ;;
  esac

  ARCHITECTURE=$(tolower "${SIMPLEX_ARCH:-$(uname -m)}")

  if [ "${ARCHITECTURE}" = "x86_64" ]; then
    # Redirect stderr to /dev/null to avoid printing errors if non Rosetta.
    if [ "$(sysctl -n sysctl.proc_translated 2>/dev/null)" = "1" ]; then
      ARCHITECTURE="arm64" # Rosetta.
    else
      ARCHITECTURE="x86_64" # Intel.
    fi
  elif [ "${ARCHITECTURE}" = "arm64" ] || [ "${ARCHITECTURE}" = "aarch64" ] ; then
    ARCHITECTURE="arm64" # Arm.
  else
    ARCHITECTURE="x86_64" # Amd.
  fi
}

# Sets RELEASE_BINS to the binaries release $1 ships. Releases ship `smplx-nextest` since 0.0.6.
set_release_bins() {
  if version_gt "0.0.6" "$1"; then
    RELEASE_BINS=("${SMPLX_BIN_NAME}" elementsd electrs)
  else
    RELEASE_BINS=("${SMPLX_BIN_NAME}" elementsd electrs smplx-nextest)
  fi
}

# Prints the attested SHA-256 of binary $1 or an empty string when the attestation lacks one
attested_hash() {
  jq -r --arg name "$1" '.subject[]? | select(.name == $name) | .digest.sha256' <<< "$ATTESTATION_STATEMENT"
}

latest_tag() {
  curl -fsSL "https://api.github.com/repos/$SIMPLEX_REPO/releases/latest" | jq -r .tag_name
}

add_v_prefix() {
  local version="${1}"

  if [[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    version="v${version}"
  fi

  echo "${version}"
}

# Compares two version strings in the format "major.minor.patch".
# Returns 0 if $1 is greater than $2, 1 if $1 is less than $2, and 1 if they are equal.
#
# Assumes that the version strings are well-formed and contain three numeric components separated by dots.
#
# Example: version_gt "1.2.3" "1.2.4"
#          returns 1 (1.2.3 < 1.2.4)
#          version_gt "1.2.3" "1.2.3"
#          returns 1 (1.2.3 == 1.2.3)
#          version_gt "1.2.4" "1.2.3"
#          returns 0 (1.2.4 > 1.2.3)
version_gt() {
  [ "$1" = "$2" ] && return 1

  IFS=. read -r major1 minor1 patch1 <<EOF
$1
EOF
  IFS=. read -r major2 minor2 patch2 <<EOF
$2
EOF

  [ "$major1" -gt "$major2" ] && return 0
  [ "$major1" -lt "$major2" ] && return 1
  [ "$minor1" -gt "$minor2" ] && return 0
  [ "$minor1" -lt "$minor2" ] && return 1
  [ "$patch1" -gt "$patch2" ] && return 0
  [ "$patch1" -lt "$patch2" ] && return 1

  return 1
}

# Extracts the simplexup installer version from standard input.
extract_installer_version() {
  grep -Eo 'SIMPLEXUP_INSTALLER_VERSION="[0-9]+\.[0-9]+\.[0-9]+"' | cut -d'"' -f2
}

compute_sha256() {
  if check_cmd sha256sum; then
    sha256sum "$1" | awk '{print $1}'
  else
    shasum -a 256 "$1" | awk '{print $1}'
  fi
}

# Downloads $1 into $2 or stdout, failing on an HTTP error
download() {
  if [ -n "$2" ]; then
    if check_cmd curl; then
      curl -f -# -L -o "$2" "$1"
    else
      wget --show-progress -qO "$2" "$1"
    fi
  else
    if check_cmd curl; then
      curl -f -# -L "$1"
    else
      wget --show-progress -qO- "$1"
    fi
  fi
}

# Joins $@ into "a, b and c"
form_str_list() {
  local items=("$@")
  local count=${#items[@]}

  if [ "$count" -le 1 ]; then
    echo "${items[*]}"
    return 0
  fi

  local head=("${items[@]:0:count-1}")
  local joined
  joined=$(IFS=","; echo "${head[*]}")

  echo "${joined//,/, } and ${items[count-1]}"
}

tolower() {
  echo "$1" | awk '{print tolower($0)}'
}

say() {
  printf "simplexup: %s\n" "$1"
}

warn() {
  say "warning: ${1}" >&2
}

err() {
  say "$1" >&2
  exit 1
}

need_cmd() {
  if ! check_cmd "$1"; then
    err "need '$1' (command not found)"
  fi
}

check_cmd() {
  command -v "$1" &>/dev/null
}

# Run a command that should never fail. If the command fails execution
# will immediately terminate with an error showing the failing command.
ensure() {
  if ! "$@"; then err "command failed: $*"; fi
}

# Banner prompt for Simplex
